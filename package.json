{
  "name": "@collidor/struct",
  "version": "0.1.0",
  "description": "Modular data structure builder with Standard Schema, JSON Schema, Zod interop, Axon graph port typing, and Vee-Validate form generation",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bridges/axon": {
      "types": "./src/bridges/axon.ts",
      "import": "./dist/bridges/axon.js",
      "require": "./dist/bridges/axon.cjs"
    },
    "./bridges/zod": {
      "types": "./src/bridges/zod.ts",
      "import": "./dist/bridges/zod.js",
      "require": "./dist/bridges/zod.cjs"
    },
    "./bridges/jsonSchema": {
      "types": "./src/bridges/jsonSchema.ts",
      "import": "./dist/bridges/jsonSchema.js",
      "require": "./dist/bridges/jsonSchema.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/collidor/struct.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "Alykam Burdzaki <alykam@gmail.com> (https://alykam.com)",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "~5.9.3",
    "vee-validate": "^4.15.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "vee-validate": "^4.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "vee-validate": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
